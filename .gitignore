*.map

# MSYS2 / MinGW build cache
__pycache__/
*.pyc
.ninja_deps
.ninja_log
build.ninja
compile_commands.json

# Mothership agent runtime (generated at runtime, not source)
mothership/state/
mothership/memory/chroma/
mothership/memory/*.db
mothership/outputs/.keep
mothership/.env

# Python venv
mothership/venv/
mothership/.venv/
*.egg-info/

