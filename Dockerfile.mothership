FROM python:3.12-slim

RUN pip install --no-cache-dir fastapi uvicorn[standard] pydantic anthropic requests

WORKDIR /app

# Copy only the mothership package
COPY mothership/ ./mothership/

EXPOSE 3000

# WAL journal mode requires the data dir to exist at runtime
VOLUME ["/data"]

CMD ["uvicorn", "mothership.server:app", "--host", "0.0.0.0", "--port", "3000"]
